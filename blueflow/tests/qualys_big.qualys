                </EXPLT>
              </EXPLT_LIST>
            </EXPLT_SRC>
          </EXPLOITABILITY>
        </CORRELATION>
        <RESULT><![CDATA[Tested on port 22 with an injected SYN/RST offset by 16 bytes.
Tested on port 80 with an injected SYN/RST offset by 16 bytes.]]></RESULT>
      </VULN>
