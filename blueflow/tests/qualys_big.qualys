        <LAST_UPDATE><![CDATA[2008-06-02T23:02:38Z]]></LAST_UPDATE>
        <PCI_FLAG>1</PCI_FLAG>
        <CVE_ID_LIST>
          <CVE_ID>
            <ID><![CDATA[CVE-1999-0103]]></ID>
