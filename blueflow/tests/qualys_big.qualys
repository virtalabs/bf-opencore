                  <LINK><![CDATA[https://github.com/tintinweb/pub/tree/master/pocs/cve-2016-3115]]></LINK>
                </EXPLT>
              </EXPLT_LIST>
            </EXPLT_SRC>
            <EXPLT_SRC>
              <SRC_NAME><![CDATA[The Exploit-DB]]></SRC_NAME>
              <EXPLT_LIST>
                <EXPLT>
                  <REF><![CDATA[CVE-2016-3115]]></REF>
                  <DESC><![CDATA[OpenSSH <= 7.2p1 - xauth Injection - The Exploit-DB Ref : 39569]]></DESC>
                  <LINK><![CDATA[http://www.exploit-db.com/exploits/39569]]></LINK>
                </EXPLT>
              </EXPLT_LIST>
            </EXPLT_SRC>
          </EXPLOITABILITY>
        </CORRELATION>
        <RESULT><![CDATA[SSH-2.0-OpenSSH_6.6.1p1 Ubuntu-2ubuntu2.7 detected on port 22 over TCP.]]></RESULT>
