                </EXPLT>
                <EXPLT>
                  <REF><![CDATA[CVE-2004-0230]]></REF>
                  <DESC><![CDATA[Multiple Vendor TCP Sequence Number Approximation Vulnerability (3) - The Exploit-DB Ref : 24032]]></DESC>
                  <LINK><![CDATA[http://www.exploit-db.com/exploits/24032]]></LINK>
                </EXPLT>
                <EXPLT>
                  <REF><![CDATA[CVE-2004-0230]]></REF>
                  <DESC><![CDATA[Multiple Vendor TCP Sequence Number Approximation Vulnerability (4) - The Exploit-DB Ref : 24033]]></DESC>
                  <LINK><![CDATA[http://www.exploit-db.com/exploits/24033]]></LINK>
                </EXPLT>
              </EXPLT_LIST>
            </EXPLT_SRC>
          </EXPLOITABILITY>
        </CORRELATION>
        <RESULT><![CDATA[Tested on port 23 with an injected SYN/RST offset by 16 bytes.
Tested on port 80 with an injected SYN/RST offset by 16 bytes.]]></RESULT>
      </VULN>
