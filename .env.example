# Django
DJANGO_SETTINGS_MODULE=project.settings.development
DATABASE_URL=postgresql://blueflow:blueflow@localhost:5432/blueflow
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=your-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: default user for create_default_user management command
DEFAULT_USERNAME=blueflow
DEFAULT_PASSWORD=blueflow

# Celery (optional; if unset, webhook task runs in-process)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Base URL for building absolute URLs in outbound webhooks (e.g. Viper integration).
# Used for upstreamApi and next/previous page links in VIPER payloads.
BLUEFLOW_BASE_URL=http://localhost:8000
