{
  "openapi": "3.0.0",
  "info": {"title": "BlueFlow contract verify fixture", "version": "1"},
  "paths": {
    "/integration": {
      "post": {
        "operationId": "integrationUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/IntegrationUploadPage"}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IntegrationUploadPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/AssetInput"}
          }
        }
      },
      "AssetInput": {
        "type": "object",
        "required": ["ip", "upstreamApi", "vendorId", "status", "utilization"],
        "properties": {
          "ip": {"type": "string"},
          "upstreamApi": {"type": "string"},
          "vendorId": {"type": "string"},
          "status": {"type": "string"},
          "utilization": {"type": "array"},
          "hostname": {"type": "string"},
          "macAddress": {"type": "string"},
          "serialNumber": {"type": "string"},
          "networkSegment": {"type": "string"},
          "cpe": {"type": "string"},
          "role": {"type": "string"},
          "location": {"type": "object"}
        }
      }
    }
  }
}
