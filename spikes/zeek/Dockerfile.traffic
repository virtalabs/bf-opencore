FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends tcpreplay python3 \
    && rm -rf /var/lib/apt/lists/*

COPY raw2enet.py /app/raw2enet.py
COPY entrypoint-traffic.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
RUN mkdir -p /logs /shared

ENTRYPOINT ["/entrypoint.sh"]
